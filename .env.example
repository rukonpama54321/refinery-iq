# ---- Copy to .env and fill in. Never commit .env ----

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (system-of-record: Postgres + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Elasticsearch (hybrid search + RAG)
ELASTICSEARCH_URL=http://elasticsearch:9200

# Redis (LLM cache + worker queue)
REDIS_URL=redis://redis:6379

# LLM providers (all API-based — no local LLM)
ANTHROPIC_API_KEY=                          # primary chat / generation (Claude)
GROQ_API_KEY=                               # fast/cheap chat + fallback
GEMINI_API_KEY=                             # OCR (vision) + embeddings
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GEMINI_EMBED_MODEL=text-embedding-004       # 768-dim embeddings

# Email (Resend) — magic-link / OTP
RESEND_API_KEY=
EMAIL_FROM=
