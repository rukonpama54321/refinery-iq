# ---- Copy to .env and fill in. Never commit .env ----

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (system-of-record: Postgres + Auth + Storage)
# Browser + server auth (cookie sessions via @supabase/ssr). The anon key is
# public by design; NEXT_PUBLIC_* are inlined into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (worker / admin tasks) — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Elasticsearch (hybrid search + RAG)
ELASTICSEARCH_URL=http://elasticsearch:9200

# Redis (LLM cache + worker queue)
REDIS_URL=redis://redis:6379

# LLM providers — fully free (ADR-0004): Groq + Gemini. No paid Anthropic.
GROQ_API_KEY=                               # primary chat (Llama 3.3 70B) — free at console.groq.com
GEMINI_API_KEY=                             # embeddings (text-embedding-004) + OCR — free at aistudio.google.com/apikey
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004       # 768-dim embeddings
# Optional — only if you obtain an Anthropic API key (Claude Pro is NOT API access):
# ANTHROPIC_API_KEY=

# Email (Resend) — magic-link / OTP
RESEND_API_KEY=
EMAIL_FROM=
