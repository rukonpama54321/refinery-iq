# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
dist/
build/

# Next.js generated TypeScript shim (regenerated on build)
next-env.d.ts
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# Docker / local data volumes
docker-data/
*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Misc
.cache/
.turbo/
.vercel

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Local archives
*.zip

# Raw source documents — may be confidential, never published
data/source-docs/*
!data/source-docs/README.md

# Real source/policy documents (HR manual, HCU manual) — local-only, not published
docs/policies/*
!docs/policies/README.md
